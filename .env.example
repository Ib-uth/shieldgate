# Copy to .env and fill in (never commit .env).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# REDIS_URL=redis://localhost:6379
# Render: use the Internal Redis URL from the Redis instance (link the Web Service to Redis).
# JWT_KEYS_DIR=/tmp/shieldgate-jwt-keys   # optional; avoids read-only app root on some hosts
# DOWNSTREAM_URL=http://localhost:8001
# DOWNSTREAM_API_PREFIX=api/v1
#
# CORS: comma-separated origins (no trailing slash). Include every admin UI origin that calls the API.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-admin.onrender.com
#
# Admin UI (Vite): set at build time for production API base URL.
# VITE_API_URL=https://your-gateway.onrender.com
#
# GitHub Actions (repo Settings → Secrets and variables): DOCKER_USERNAME, DOCKER_PASSWORD (token);
# Variables: DOCKER_PUSH_TO_HUB=true, DOCKERHUB_NAMESPACE=your-dockerhub-user (pushes user/gateway, user/mock).
