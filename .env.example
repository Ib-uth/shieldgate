# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shieldgate
# In production (Render), DATABASE_URL is set as a secret from the PostgreSQL service

# Services
DOWNSTREAM_URL=http://localhost:8001
REDIS_URL=redis://localhost:6379
# In production (Render), REDIS_URL comes from the Redis instance connection string
# Format: redis://<service-name>:<port> (e.g., redis://shieldgate-redis:6379)

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Logging & ML
LOG_LEVEL=INFO
THREAT_MODEL_PATH=./models/threat_model.joblib

# Rate Limiting
RATE_LIMIT_IP_REQUESTS=60
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_USER_REQUESTS=300
RATE_LIMIT_USER_WINDOW=60

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list for production: http://localhost:3000,https://shieldgate.yourdomain.com

# Threat Detection
THREAT_SCORE_FLAG_THRESHOLD=0.7
THREAT_SCORE_BLOCK_THRESHOLD=0.9

# Gateway Settings
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
