# Multi-stage Dockerfile for ShieldGate API Gateway
FROM python:3.11-slim as base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd --create-home --shell /bin/bash shieldgate

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy application code
COPY apps/ ./apps/
COPY alembic.ini alembic.ini
COPY alembic/ ./alembic/

# Change ownership to app user
RUN chown -R shieldgate:shieldgate /app

# Switch to app user
USER shieldgate

# Create necessary directories
RUN mkdir -p /app/keys /app/models /app/logs

# Training stage - generate threat detection model
FROM base as training

# Copy training script
COPY scripts/ ./scripts/

# Generate RSA keys and train model
RUN python scripts/generate_keys.py --private-key /app/keys/private.pem --public-key /app/keys/public.pem && \
    python scripts/train_model.py --output /app/models/threat_model.joblib --samples 10000

# Production stage
FROM base as production

# Copy artifacts from training stage
COPY --from=training /app/keys /app/keys
COPY --from=training /app/models /app/models

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "apps.gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
